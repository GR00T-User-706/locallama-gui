#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install -- --install-lib=/usr/lib/python3/dist-packages
	install -Dm755 debian/myloai-launcher debian/myloai/usr/bin/myloai
	install -Dm644 ../myloai.desktop debian/myloai/usr/share/applications/myloai.desktop
	install -Dm644 ../myloai.1 debian/myloai/usr/share/man/man1/myloai.1
	install -Dm644 ../RELEASE_PAYLOAD.md debian/myloai/usr/share/doc/myloai/README.packaging
	install -Dm644 ../appimage/myloai.svg debian/myloai/usr/share/icons/hicolor/scalable/apps/myloai.svg
