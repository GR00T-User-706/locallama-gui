pkgname=myloai
pkgver=1.2.12
pkgrel=2
pkgdesc='MyLoAI Control Center'
arch=('x86_64')
url='https://github.com/GR00T-User-706/locallama-gui'
license=('custom')

depends=(
    'glibc'
    'gcc-libs'
    'fontconfig'
    'libgl'
    'libx11'
    'libxext'
    'libxrender'
    'libxcb'
    'libxkbcommon'
    'dbus'
)

makedepends=(
    'python-pyinstaller'
    'python-pyside6'
    'python-httpx'
    'python-platformdirs'
    'python-pydantic'
    'python-psutil'
    'python-markdown'
    'python-keyring'
)

source=(
    "myloai-${pkgver}.tar.gz::https://github.com/GR00T-User-706/locallama-gui/archive/refs/heads/main.tar.gz"
)

sha256sums=('SKIP')

build() {
    cd "$srcdir/locallama-gui-main"

    /usr/bin/python -m PyInstaller \
        --noconfirm \
        --clean \
        --distpath dist \
        --workpath build/pyinstaller \
        packaging/pyinstaller/myloai.spec
}

package() {
    cd "$srcdir/locallama-gui-main"

    install -dm755 "$pkgdir/opt/myloai"
    cp -a dist/MyLoAI_Control_Center/. "$pkgdir/opt/myloai/"

    install -d "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/myloai" <<'EOF'
#!/bin/sh
exec /opt/myloai/MyLoAI_Control_Center "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/myloai"

    install -Dm644 packaging/linux/myloai.desktop \
        "$pkgdir/usr/share/applications/myloai.desktop"

    install -Dm644 packaging/linux/myloai.1 \
        "$pkgdir/usr/share/man/man1/myloai.1"

    install -Dm644 packaging/USER_MANUAL.md \
        "$pkgdir/usr/share/doc/myloai/USER_MANUAL.md"

    install -Dm644 packaging/linux/appimage/myloai.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/myloai.svg"

    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/myloai/LICENSE"
}
